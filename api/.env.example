# Copy to .env (chmod 600). All values are optional; defaults shown. Every key needs the AIWAZZ_ prefix.
AIWAZZ_ENV=production     # "development" or "test" enables /api/docs
AIWAZZ_HOST=127.0.0.1
AIWAZZ_PORT=8100
# AIWAZZ_STORAGE_DIR=/www/aiwazz/api/storage
AIWAZZ_AUDIO_RETENTION_DAYS=7

AIWAZZ_TORCH_THREADS=4
AIWAZZ_MAX_CHARS=5000
AIWAZZ_MAX_QUEUE=20
AIWAZZ_SENTENCE_PAUSE_MS=250
AIWAZZ_PARAGRAPH_PAUSE_MS=600

# Post-processing
AIWAZZ_SAMPLE_RATE=48000
AIWAZZ_MP3_BITRATE=192k
AIWAZZ_EDGE_SILENCE_MS=100
AIWAZZ_SILENCE_THRESHOLD_DB=-45
AIWAZZ_LOUDNESS_LUFS=-14         # default target; per request: "loudness_lufs" (-30..-8) or "normalize": false
AIWAZZ_TRUE_PEAK_DB=-1
AIWAZZ_COMPRESSOR=true          # gentle 2:1 RMS compressor before gain + limiter
AIWAZZ_COMPRESSOR_THRESHOLD_REL_DB=0
AIWAZZ_COMPRESSOR_RATIO=2
