# Copy to .env (chmod 600). All values are optional; defaults shown.
ENV=production            # anything else enables /api/docs
HOST=127.0.0.1
PORT=8100
# STORAGE_DIR=/www/aiwazz/api/storage
AUDIO_RETENTION_DAYS=7

TORCH_THREADS=4
MAX_CHARS=5000
MAX_QUEUE=20
SENTENCE_PAUSE_MS=250
PARAGRAPH_PAUSE_MS=600

# Post-processing
SAMPLE_RATE=48000
MP3_BITRATE=192k
EDGE_SILENCE_MS=100
SILENCE_THRESHOLD_DB=-45
LOUDNESS_LUFS=-14         # default target; per request: "loudness_lufs" (-30..-8) or "normalize": false
TRUE_PEAK_DB=-1
