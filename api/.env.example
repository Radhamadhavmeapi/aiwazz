# Copy to .env (chmod 600). All values are optional; defaults shown. Every key needs the AIWAZZ_ prefix.
AIWAZZ_ENV=production     # "development" or "test" enables /api/docs
AIWAZZ_HOST=127.0.0.1
AIWAZZ_PORT=8100
# AIWAZZ_STORAGE_DIR=/www/aiwazz/api/storage
AIWAZZ_AUDIO_RETENTION_DAYS=7

AIWAZZ_TORCH_THREADS=4
AIWAZZ_MAX_CHARS=5000
AIWAZZ_MAX_QUEUE=20
AIWAZZ_SENTENCE_PAUSE_MS=250
AIWAZZ_PARAGRAPH_PAUSE_MS=600

# Post-processing
AIWAZZ_SAMPLE_RATE=48000
AIWAZZ_MP3_BITRATE=192k
AIWAZZ_EDGE_SILENCE_MS=100
AIWAZZ_SILENCE_THRESHOLD_DB=-45
AIWAZZ_LOUDNESS_LUFS=-14         # default target; per request: "loudness_lufs" (-30..-8) or "normalize": false
AIWAZZ_TRUE_PEAK_DB=-1
AIWAZZ_COMPRESSOR=true          # gentle 2:1 RMS compressor before gain + limiter
AIWAZZ_COMPRESSOR_THRESHOLD_REL_DB=0
AIWAZZ_COMPRESSOR_RATIO=2

# Database (MariaDB, own user, localhost only) + Redis (db 5; db 0 belongs to another project)
AIWAZZ_DATABASE_URL=mysql+aiomysql://aiwazz_voice:CHANGE_ME@127.0.0.1:3306/aiwazz_voice?charset=utf8mb4
AIWAZZ_REDIS_URL=redis://127.0.0.1:6379/5

# Auth
AIWAZZ_COOKIE_SECURE=true        # false only for local http development
AIWAZZ_SESSION_DAYS=30
AIWAZZ_LOGIN_MAX_PER_EMAIL=5     # per 15 min
AIWAZZ_LOGIN_MAX_PER_IP=20       # per 15 min
AIWAZZ_SIGNUP_MAX_PER_IP=10      # per hour

# Mail (self-hosted Postfix, content/MAIL-SERVER.md). Keep false until the deliverability test passes.
AIWAZZ_MAIL_ENABLED=false
AIWAZZ_SMTP_HOST=127.0.0.1
AIWAZZ_SMTP_PORT=587
AIWAZZ_SMTP_USER=noreply@aiwazz.in
# AIWAZZ_SMTP_PASSWORD=   → set with: .venv/bin/python manage.py set-secret AIWAZZ_SMTP_PASSWORD (hidden prompt)

# Razorpay (TEST keys first: rzp_test_…). Set secrets with manage.py set-secret (hidden prompt), never paste them here.
# AIWAZZ_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# AIWAZZ_RAZORPAY_KEY_SECRET=
# AIWAZZ_RAZORPAY_WEBHOOK_SECRET=
# AIWAZZ_RAZORPAY_PLAN_IDS={"starter_monthly":"plan_…",…}   → written by manage.py billing-create-plans
