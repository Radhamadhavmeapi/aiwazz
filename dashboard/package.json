{
  "name": "aiwazz-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync-brand": "node scripts/sync-brand.mjs",
    "predev": "npm run sync-brand",
    "prebuild": "npm run sync-brand",
    "prebuild:preview": "npm run sync-brand",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && VITE_PREVIEW=1 vite build --base=/preview/ --outDir dist-preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cn": "^0.5.2",
    "framer-motion": "14.14.0",
    "lucide-react": "1.78.0",
    "next-themes": "^0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "wavesurfer.js": "8.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
