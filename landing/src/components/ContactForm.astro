---
// Posts to /api/contact (nginx proxies it same-origin to the AiWazz API). Honeypot + rate limit server-side.
// topic: lands in the right queue of the support inbox (grievances get the legal timelines; misuse reports also
// go to Moderation). The grievance page shows this form with topic "grievance" preselected.
import { LEGAL } from "../lib/legal";
const { topic = "general" } = Astro.props as { topic?: string };
---
<section aria-labelledby="contact-form-title" class="mt-12 rounded-2xl border bg-surface p-5 shadow-md sm:p-6">
  <h2 id="contact-form-title" class="text-xl font-semibold text-foreground">Send us a message</h2>
  <form id="contact-form" class="mt-5 grid gap-4" novalidate>
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="grid gap-1.5 text-sm font-medium text-foreground">Name
        <input name="name" required maxlength="100" autocomplete="name" class="h-11 rounded-lg border border-input bg-surface-2 px-3 text-[15px] font-normal" />
      </label>
      <label class="grid gap-1.5 text-sm font-medium text-foreground">Email
        <input name="email" type="email" required maxlength="254" autocomplete="email" class="h-11 rounded-lg border border-input bg-surface-2 px-3 text-[15px] font-normal" />
      </label>
    </div>
    <label class="grid gap-1.5 text-sm font-medium text-foreground">Topic
      <select name="topic" class="h-11 rounded-lg border border-input bg-surface-2 px-3 text-[15px] font-normal">
        <option value="general" selected={topic === "general"}>General question</option>
        <option value="billing" selected={topic === "billing"}>Billing or invoice</option>
        <option value="grievance" selected={topic === "grievance"}>Grievance (complaint to the Grievance Officer)</option>
        <option value="abuse" selected={topic === "abuse"}>Report misuse (impersonation, scam or harmful audio)</option>
      </select>
    </label>
    <label class="grid gap-1.5 text-sm font-medium text-foreground">Subject
      <input name="subject" required maxlength="150" class="h-11 rounded-lg border border-input bg-surface-2 px-3 text-[15px] font-normal" />
    </label>
    <label class="grid gap-1.5 text-sm font-medium text-foreground">Message
      <textarea name="message" required minlength="10" maxlength="4000" rows="5" class="rounded-lg border border-input bg-surface-2 px-3 py-2.5 text-[15px] font-normal"></textarea>
    </label>
    <div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden">
      <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <label class="flex items-start gap-2.5 text-sm text-muted-foreground">
      <input name="consent" type="checkbox" required class="mt-1 size-4 accent-[var(--primary)]" />
      <span>I agree that AiWazz may use these details to reply to me, as described in the <a href="/privacy/" class="text-brand underline underline-offset-2">Privacy Policy</a>.</span>
    </label>
    <div class="flex flex-wrap items-center gap-3">
      <button type="submit" class="inline-flex h-11 items-center rounded-xl bg-brand-gradient-strong px-5 text-[15px] font-semibold text-white shadow-brand-glow hover:brightness-110 disabled:opacity-60">Send message</button>
      <p id="contact-status" role="status" aria-live="polite" class="text-sm"></p>
    </div>
    <p class="text-xs text-subtle-foreground">Prefer email? Write to <a href={`mailto:${LEGAL.supportEmail}`} class="text-brand underline underline-offset-2">{LEGAL.supportEmail}</a>.</p>
  </form>
</section>
<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("contact-status");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
    const data = Object.fromEntries(new FormData(form));
    btn.disabled = true;
    status!.className = "text-sm text-muted-foreground";
    status!.textContent = "Sending…";
    try {
      const r = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ ...data, consent: data.consent === "on" }),
      });
      if (r.ok) {
        form.reset();
        status!.className = "text-sm text-success";
        status!.textContent = "Thanks! We usually reply within one business day.";
      } else {
        const body = await r.json().catch(() => ({}));
        const d = body.detail;
        throw new Error(typeof d === "string" ? d : Array.isArray(d) ? String(d[0]?.msg ?? "").replace(/^Value error, /, "") : "");
      }
    } catch (err) {
      status!.className = "text-sm text-danger";
      status!.textContent = (err as Error).message || "Couldn't send. Please email us instead.";
    } finally {
      btn.disabled = false;
    }
  });
</script>
