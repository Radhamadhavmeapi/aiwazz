---
import Icon from "./Icon.astro";
export type QA = { q: string; a: string };
interface Props { items: QA[]; title?: string }
const { items, title = "Questions, answered" } = Astro.props;
---
<section id="faq" aria-labelledby="faq-title" class="mx-auto max-w-3xl px-4 py-20 sm:px-6 sm:py-28">
  <h2 id="faq-title" class="text-center text-h1 font-semibold">{title}</h2>
  <div class="mt-10 divide-y rounded-2xl border bg-surface">
    {items.map(({ q, a }) => (
      <details class="group px-5 sm:px-6">
        <summary class="flex cursor-pointer items-center justify-between gap-4 py-5 text-left text-[15px] font-medium">
          {q}
          <Icon name="arrow-right" class="size-4 text-muted-foreground transition-transform duration-200 group-open:rotate-90" />
        </summary>
        <p class="-mt-1 pb-5 text-[15px] leading-7 text-muted-foreground">{a}</p>
      </details>
    ))}
  </div>
</section>
