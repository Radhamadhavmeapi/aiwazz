---
import { LEGAL } from "../lib/legal";
import { FOOTER } from "../data/site";
import Logo from "./Logo.astro";
const cols = [
  { title: "Product", links: FOOTER.product },
  { title: "Learn", links: FOOTER.learn },
  { title: "Company", links: FOOTER.company },
  { title: "Legal", links: FOOTER.legal },
];
const tel = LEGAL.phone.replace(/\s+/g, "");
---
<footer class="border-t">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr_1fr]">
    <div>
      <Logo variant="full" width={180} />
      <p class="mt-4 max-w-xs text-sm leading-6 text-muted-foreground">
        Natural AI voiceovers in Hindi, Hinglish &amp; English, made for reels, shorts and ads.
      </p>
      <p class="mt-2 text-sm text-subtle-foreground">Har shabd ko awaaz.</p>
    </div>
    {cols.map((c) => (
      <nav aria-label={c.title}>
        <p class="text-sm font-semibold">{c.title}</p>
        <ul class="mt-3 space-y-2 text-sm">
          {c.links.map((l) => <li><a href={l.href} class="text-muted-foreground transition-colors hover:text-foreground">{l.label}</a></li>)}
        </ul>
      </nav>
    ))}
  </div>
  <div class="border-t">
    <p class="mx-auto max-w-6xl px-4 py-6 text-xs leading-6 text-subtle-foreground sm:px-6">
      © 2026 {LEGAL.legalName} · AiWazz is a brand of {LEGAL.parentBrand} · GSTIN {LEGAL.gstin} · {LEGAL.address} ·
      <a href={`mailto:${LEGAL.supportEmail}`} class="underline-offset-2 hover:text-foreground hover:underline">{LEGAL.supportEmail}</a> ·
      <a href={`tel:${tel}`} class="underline-offset-2 hover:text-foreground hover:underline">{LEGAL.phone}</a>
    </p>
  </div>
</footer>
