---
import { SITE } from "../data/site";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
const nav = [
  { href: "/#samples", label: "Samples" },
  { href: "/#features", label: "Features" },
  { href: "/#how-it-works", label: "How it works" },
  { href: "/#faq", label: "FAQ" },
];
---
<header class="glass sticky top-0 z-40 border-b">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-4 sm:px-6">
    <a href="/" class="shrink-0 rounded-md" aria-label="AiWazz home"><Logo width={124} /></a>
    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {nav.map((n) => <a href={n.href} class="rounded-lg px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground">{n.label}</a>)}
    </nav>
    <div class="ml-auto flex items-center gap-1.5">
      <button type="button" data-theme-toggle aria-label="Switch to light theme" class="grid size-9 place-items-center rounded-lg text-muted-foreground transition-colors hover:bg-surface-2 hover:text-foreground">
        <Icon name="sun" class="hidden size-[18px] [:root:not(.light)_&]:inline-block" />
        <Icon name="moon" class="hidden size-[18px] [.light_&]:inline-block" />
      </button>
      <a href={SITE.signIn} class="hidden h-9 items-center rounded-lg px-3 text-sm font-medium text-foreground transition-colors hover:bg-surface-2 sm:inline-flex">Sign in</a>
      <a href={SITE.getInvite} class="inline-flex h-9 items-center gap-1.5 rounded-lg bg-brand-gradient-strong px-3.5 text-sm font-semibold text-white shadow-brand-glow transition-[filter] hover:brightness-110">Get invite</a>
      <button type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu" class="grid size-9 place-items-center rounded-lg text-muted-foreground hover:bg-surface-2 hover:text-foreground md:hidden">
        <Icon name="menu" class="size-5" />
      </button>
    </div>
  </div>
  <nav id="mobile-menu" hidden aria-label="Mobile" class="border-t px-4 py-3 md:hidden">
    {nav.map((n) => <a href={n.href} class="block rounded-lg px-3 py-2.5 text-[15px] text-muted-foreground hover:bg-surface-2 hover:text-foreground">{n.label}</a>)}
    <a href={SITE.signIn} class="block rounded-lg px-3 py-2.5 text-[15px] font-medium hover:bg-surface-2">Sign in</a>
  </nav>
</header>
