---
// Inline lucide icon (no JS). Usage: <Icon name="mic" class="size-5" />
interface Props { name: string; class?: string; label?: string }
const { name, class: cls = "size-5", label } = Astro.props;
const icons = import.meta.glob<string>("../../node_modules/lucide-static/icons/*.svg", { query: "?raw", import: "default", eager: true });
const svg = icons[`../../node_modules/lucide-static/icons/${name}.svg`];
if (!svg) throw new Error(`Unknown icon: ${name}`);
---
<span class:list={["icon shrink-0", cls]} role={label ? "img" : undefined} aria-label={label} aria-hidden={label ? undefined : "true"} set:html={svg} />
