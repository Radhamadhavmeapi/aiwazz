---
import { LEGAL, type LegalPage } from "../lib/legal";
import { SITE } from "../data/site";
import Base from "./Base.astro";

interface Props { page: LegalPage; jsonLd?: object[]; wide?: boolean }
const { page, jsonLd = [], wide = false } = Astro.props;
const url = `${SITE.url}/${page.slug}/`;
const crumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "AiWazz", item: `${SITE.url}/` },
    { "@type": "ListItem", position: 2, name: page.title, item: url },
  ],
};
const showToc = page.toc.length >= 5 && !wide;
---
<Base title={page.metaTitle} description={page.metaDescription} jsonLd={[crumbs, ...jsonLd]}>
  <div class="border-b bg-surface/40">
    <div class="mx-auto max-w-6xl px-4 pt-12 pb-10 sm:px-6 sm:pt-16">
      <nav aria-label="Breadcrumb" class="text-xs text-subtle-foreground">
        <a href="/" class="hover:text-foreground">AiWazz</a> <span aria-hidden="true">/</span> <span aria-current="page">{page.title}</span>
      </nav>
      <h1 class="mt-4 text-[2.25rem] leading-[1.1] font-bold tracking-[-0.03em] sm:text-[2.75rem]">{page.title}</h1>
      <p class="mt-3 text-sm text-muted-foreground">Last updated: {LEGAL.lastUpdated}</p>
    </div>
  </div>
  {Astro.slots.has("top") && (
    <div class="mx-auto max-w-6xl px-4 pt-12 sm:px-6">
      <slot name="top" />
    </div>
  )}
  <div class:list={["mx-auto grid max-w-6xl gap-12 px-4 py-12 sm:px-6", showToc && "lg:grid-cols-[minmax(0,1fr)_220px]"]}>
    <div class="min-w-0 max-w-[70ch]">
      <article class="prose-legal">
        <Fragment set:html={page.html} />
      </article>
      <slot />
    </div>
    {showToc && (
      <nav aria-label="On this page" class="hidden lg:block">
        <div class="sticky top-24">
          <p class="text-xs font-semibold tracking-wide text-muted-foreground uppercase">On this page</p>
          <ul class="mt-3 space-y-2 border-l text-sm">
            {page.toc.map((t) => <li><a href={`#${t.id}`} class="-ml-px block border-l border-transparent pl-3 text-muted-foreground transition-colors hover:border-foreground hover:text-foreground">{t.text}</a></li>)}
          </ul>
        </div>
      </nav>
    )}
  </div>
</Base>
