---
import SeoPage, { type Block } from "../components/SeoPage.astro";
import type { QA } from "../components/Faq.astro";

const blocks: Block[] = [
  {
    h2: "Hindi text to speech that actually sounds Hindi",
    p: [
      "AiWazz was built for Hindi first. Its four Hindi voices (two female, two male) read Devanagari with natural rhythm, so your voiceover sounds like someone from India recorded it.",
      "Write your script in Devanagari (हिंदी), paste it in, choose Alpha, Beta, Omega or Psi, and download the audio in about a minute.",
    ],
  },
  {
    h2: "हिंदी टेक्स्ट टू स्पीच",
    p: [
      "अपनी स्क्रिप्ट हिंदी में लिखें या पेस्ट करें, आवाज़ चुनें और लगभग एक मिनट में अपना वॉइसओवर डाउनलोड करें। AiWazz की चार हिंदी आवाज़ें देवनागरी को स्वाभाविक लय के साथ पढ़ती हैं, ताकि आपकी रील, विज्ञापन या वीडियो सुनने में अपनापन लगे।",
      "रोमन अक्षरों में लिखी हिंग्लिश भी चलेगी: “Transliterate Hinglish” चालू करें, और “Raat 11 baje” जैसी पंक्तियाँ अपने-आप “रात 11 बजे” बन जाती हैं। अंग्रेज़ी शब्द वैसे ही रहते हैं।",
    ],
  },
  {
    h2: "Made for Hinglish, the way people really speak",
    p: [
      "Most reels and ads in India are in Hinglish: Hindi sentences with English words like order, customer or offer. Keep the Hindi parts in Devanagari and the English words in English, and the Hindi voices handle the mix naturally.",
      "Typing Hindi in Roman letters (\"Raat 11 baje customer ne call kiya\")? Turn on Transliterate Hinglish and paste it exactly as you type it in WhatsApp: it becomes \"रात 11 बजे customer ने call किया\", and you can see the converted text before you generate.",
    ],
  },
  {
    h2: "Ready for Instagram, YouTube and WhatsApp",
    list: [
      "Loudness set to -14 LUFS, the loudness most short-video platforms target, so your voice never sounds quiet next to other videos.",
      "Peaks kept under -1 dBTP so the audio doesn't distort when platforms compress it.",
      "Clean starts and ends: silence trimmed to about 100 ms, even pauses between sentences.",
      "MP3 for quick sharing, WAV for editing in CapCut, Premiere, DaVinci Resolve or Remotion.",
    ],
    p: [],
  },
  {
    h2: "Who uses Hindi text to speech?",
    p: [
      "Creators making daily reels, small businesses explaining products, teachers recording lessons, and agencies producing ads in Hindi and English for the same campaign. Anywhere a clear Hindi voice is needed quickly, without booking a voice artist or recording at home.",
    ],
  },
];

const faq: QA[] = [
  { q: "Can AiWazz read Hindi written in English letters?", a: "Yes. Turn on Transliterate Hinglish and Roman Hindi is converted to Devanagari before the voice reads it; English words stay in English. The dashboard shows the converted text so you can check it first." },
  { q: "How many Hindi voices are there?", a: "Four: Alpha and Beta (female), Omega and Psi (male). You can preview all of them on this page." },
  { q: "Can I mix Hindi and English in one script?", a: "Yes. Keep the Hindi words in Devanagari and English words in English, and the Hindi voices read the mix naturally." },
  { q: "Is the Hindi voiceover allowed in paid ads?", a: "Yes, on a paid plan. Paid plans include commercial rights (ads, client work, monetised videos); the Free plan is for personal use. See our Terms at aiwazz.in/terms/." },
];
---
<SeoPage
  title="Hindi text to speech: natural AI Hindi & Hinglish voices | AiWazz"
  description="Natural Hindi text to speech for reels, ads and lessons. 4 Hindi AI voices that read Devanagari and Hinglish naturally, reel-ready MP3 or WAV in about a minute."
  eyebrow="Hindi text to speech"
  h1="Hindi text to speech with natural Hindi voices"
  lead="Paste your Hindi or Hinglish script and get a clear, natural voiceover in about a minute. Har shabd ko awaaz."
  blocks={blocks}
  faq={faq}
  langs={["h"]}
  samplesHeading="Hear the Hindi voices"
  cta="Give your Hindi script a voice."
/>
