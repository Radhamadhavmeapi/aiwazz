<script>
  import "../scripts/waveform";
  import "../scripts/player";
  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-demo-tab]");
  const chip = document.querySelector("#demo-chip span:last-child");
  tabs.forEach((t) =>
    t.addEventListener("click", () => {
      const v = t.dataset.demoTab!;
      tabs.forEach((x) => x.setAttribute("aria-selected", String(x === t)));
      document.querySelectorAll<HTMLElement>("[data-demo-panel]").forEach((p) => (p.hidden = p.dataset.demoPanel !== v));
      if (chip) chip.textContent = v === "hi" ? "Playing: Hindi, Alpha" : "Playing: English, Michael";
    }),
  );
</script>
