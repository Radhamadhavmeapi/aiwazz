---
import Icon from "../../components/Icon.astro";
import { SITE } from "../../data/site";
import Base from "../../layouts/Base.astro";
import { CATEGORIES, loadGuides } from "../../lib/learn";

const guides = (await loadGuides()).filter((g) => g.slug);
const popular = ["getting-started", "hindi-and-hinglish", "writing-scripts", "api-quickstart"].map((s) => guides.find((g) => g.slug === s)!);
// tiny search index (title, headings, text), built at build time
const index = guides.map((g) => ({ u: g.url, t: g.title, c: CATEGORIES.find((c) => c.id === g.category)?.label, h: g.toc.map((x) => x.text).join(" · "), x: g.text.slice(0, 4000) }));
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "AiWazz", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Learn", item: `${SITE.url}/learn/` },
    ],
  },
];
---
<Base title="Learn AiWazz: guides for AI voiceovers in Hindi & English" description="Guides for AiWazz: make your first voiceover, write natural scripts, Hindi and Hinglish tips, loudness, editors, the API and account help." jsonLd={jsonLd}>
  <section class="relative overflow-hidden border-b">
    <div aria-hidden="true" class="hero-grid absolute inset-0"></div>
    <div class="relative mx-auto max-w-3xl px-4 pt-14 pb-12 text-center sm:px-6 sm:pt-20">
      <p class="font-mono text-xs tracking-wider text-brand uppercase">Learn</p>
      <h1 class="mt-3 text-[2.5rem] leading-[1.1] font-bold tracking-[-0.03em] sm:text-[3rem]">Learn AiWazz</h1>
      <p class="mt-4 text-lg text-muted-foreground">Everything you need to go from a script to a finished voiceover. New here? Start with Getting started: it takes 3 minutes.</p>
      <form role="search" class="relative mx-auto mt-8 max-w-xl" action="/learn/" method="get" onsubmit="return false">
        <label for="learn-q" class="sr-only">Search the guides</label>
        <Icon name="search" class="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-subtle-foreground" />
        <input id="learn-q" name="q" type="search" autocomplete="off" placeholder="Search guides: Hinglish, loudness, API key…" class="h-13 w-full rounded-2xl border border-input bg-surface pr-4 pl-12 text-[16px] shadow-md" />
      </form>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <section id="results" hidden aria-live="polite">
      <h2 class="text-h3 font-semibold" id="results-title">Results</h2>
      <ul class="mt-4 grid gap-3" id="results-list"></ul>
    </section>

    <div id="browse">
      <section aria-labelledby="popular-title">
        <h2 id="popular-title" class="text-h3 font-semibold">Popular guides</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {popular.map((g) => (
            <li><a href={g.url} class="block h-full rounded-2xl border bg-surface p-5 shadow-md transition-colors hover:bg-surface-2">
              <span class="font-semibold">{g.title}</span>
              <span class="mt-1.5 block text-sm leading-6 text-muted-foreground">{g.metaDescription}</span>
            </a></li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="cats-title" class="mt-14">
        <h2 id="cats-title" class="text-h3 font-semibold">All guides</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {CATEGORIES.map((c) => (
            <div class="rounded-2xl border bg-surface p-5">
              <p class="flex items-center gap-2 font-semibold"><span class="grid size-8 place-items-center rounded-lg border bg-surface-2 text-brand"><Icon name={c.icon} class="size-4" /></span>{c.label}</p>
              <ul class="mt-3 space-y-2 text-sm">
                {guides.filter((g) => g.category === c.id).map((g) => <li><a href={g.url} class="text-muted-foreground hover:text-foreground">{g.title}</a></li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>
      <p class="mt-12 text-sm text-muted-foreground">Still stuck? <a href="/contact/" class="text-brand underline underline-offset-2">Contact us</a>. We reply within one business day.</p>
    </div>
  </div>
  <script type="application/json" id="learn-index" set:html={JSON.stringify(index)} />
</Base>

<script>
  type Item = { u: string; t: string; c: string; h: string; x: string };
  const idx: Item[] = JSON.parse(document.getElementById("learn-index")!.textContent || "[]");
  const input = document.getElementById("learn-q") as HTMLInputElement;
  const results = document.getElementById("results")!;
  const browse = document.getElementById("browse")!;
  const list = document.getElementById("results-list")!;
  const title = document.getElementById("results-title")!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  function search(q: string) {
    const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
    if (!terms.length) return ((results.hidden = true), (browse.hidden = false));
    const scored = idx
      .map((it) => {
        const t = it.t.toLowerCase(), h = it.h.toLowerCase(), x = it.x.toLowerCase();
        let score = 0;
        for (const w of terms) {
          if (!(t.includes(w) || h.includes(w) || x.includes(w))) return { it, score: 0, snip: "" };
          score += (t.includes(w) ? 10 : 0) + (h.includes(w) ? 4 : 0) + (x.split(w).length - 1);
        }
        const pos = x.indexOf(terms[0]);
        const snip = pos >= 0 ? (pos > 60 ? "…" : "") + it.x.slice(Math.max(0, pos - 60), pos + 120) + "…" : "";
        return { it, score, snip };
      })
      .filter((r) => r.score > 0)
      .sort((a, b) => b.score - a.score);
    results.hidden = false;
    browse.hidden = true;
    title.textContent = scored.length ? `${scored.length} guide${scored.length > 1 ? "s" : ""} for “${q}”` : `No guides found for “${q}”`;
    list.innerHTML = scored
      .map((r) => `<li><a href="${r.it.u}" class="block rounded-2xl border bg-surface p-4 hover:bg-surface-2"><span class="text-xs text-subtle-foreground">${esc(r.it.c)}</span><span class="mt-0.5 block font-semibold">${esc(r.it.t)}</span><span class="mt-1 block text-sm text-muted-foreground">${esc(r.snip)}</span></a></li>`)
      .join("") || `<li class="text-sm text-muted-foreground">Try other words, or <a class="text-brand underline" href="/contact/">contact us</a>.</li>`;
  }
  const q0 = new URLSearchParams(location.search).get("q") || "";
  if (q0) ((input.value = q0), search(q0));
  input.addEventListener("input", () => {
    search(input.value.trim());
    const u = new URL(location.href);
    input.value.trim() ? u.searchParams.set("q", input.value.trim()) : u.searchParams.delete("q");
    history.replaceState(null, "", u);
  });
</script>
