---
import Icon from "../components/Icon.astro";
import LegalLayout from "../layouts/LegalLayout.astro";
import { SITE } from "../data/site";
import { fmtINR, legalPage, LEGAL } from "../lib/legal";

const page = legalPage("pricing");
const disc = LEGAL.yearlyDiscountPercent;
const plans = LEGAL.plans.map((p) => {
  const yearly = Math.round(p.priceMonthly * 12 * (1 - disc / 100));
  return {
    ...p,
    yearly,
    yearlyPerMonth: Math.round(yearly / 12),
    minutes: Math.round(p.characters / 800),
    popular: p.id === "creator",
    href: p.id === "free" ? `${SITE.app}/signup` : `${SITE.app}/signup?plan=${p.id}`,
  };
});

// FAQ for JSON-LD: "**Question?** Answer" paragraphs under "## FAQ"
const faqMd = page.markdown.split(/^## FAQ\s*$/m)[1] ?? "";
const faq = [...faqMd.matchAll(/^\*\*(.+?)\*\*\s+(.+)$/gm)].map((m) => ({
  q: m[1],
  a: m[2].replace(/\[([^\]]+)\]\([^)]+\)/g, "$1"),
}));
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "AiWazz",
    applicationCategory: "MultimediaApplication",
    operatingSystem: "Web",
    url: SITE.url,
    description: SITE.description,
    offers: plans.map((p) => ({
      "@type": "Offer",
      name: `${p.name} (monthly)`,
      price: p.priceMonthly,
      priceCurrency: "INR",
      url: `${SITE.url}/pricing/`,
      category: p.priceMonthly ? "subscription" : "free",
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<LegalLayout page={page} jsonLd={jsonLd} wide>
  <div slot="top" data-billing="monthly" id="plans">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <p class="text-[17px] text-muted-foreground">Pick a plan, generate voiceovers, cancel any time.</p>
      <div role="group" aria-label="Billing period" class="inline-flex rounded-xl border bg-surface p-1 text-sm">
        <button type="button" data-period="monthly" aria-pressed="true" class="rounded-lg px-3.5 py-1.5 font-medium text-muted-foreground aria-pressed:bg-foreground aria-pressed:text-background">Monthly</button>
        <button type="button" data-period="yearly" aria-pressed="false" class="rounded-lg px-3.5 py-1.5 font-medium text-muted-foreground aria-pressed:bg-foreground aria-pressed:text-background">Yearly <span class="text-success [[aria-pressed=true]_&]:text-background">−{disc}%</span></button>
      </div>
    </div>

    <ul class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {plans.map((p) => (
        <li class:list={["relative flex flex-col rounded-2xl border bg-surface p-6 shadow-md", p.popular && "border-transparent shadow-brand-glow"]}>
          {p.popular && <span class="absolute -top-3 left-6 rounded-full bg-brand-gradient-strong px-3 py-1 text-xs font-semibold text-white">Most popular</span>}
          <h2 class="text-lg font-semibold text-foreground">{p.name}</h2>
          <p class="mt-4 flex items-baseline gap-1 text-foreground">
            <span class="price-monthly font-heading text-[2.25rem] leading-none font-bold tracking-tight">{fmtINR(p.priceMonthly)}</span>
            <span class="price-yearly hidden font-heading text-[2.25rem] leading-none font-bold tracking-tight">{fmtINR(p.yearlyPerMonth)}</span>
            <span class="text-sm text-muted-foreground">/month</span>
          </p>
          <p class="mt-1.5 min-h-[2.5rem] text-xs leading-5 text-subtle-foreground">
            {p.priceMonthly === 0 ? "Free forever, no card needed" : (
              <>
                <span class="price-monthly">+ {LEGAL.gstRatePercent}% GST · billed monthly</span>
                <span class="price-yearly hidden">{fmtINR(p.yearly)} billed yearly + {LEGAL.gstRatePercent}% GST</span>
              </>
            )}
          </p>
          <p class="mt-4 text-sm text-foreground"><strong class="font-semibold">{p.characters.toLocaleString("en-IN")}</strong> characters / month</p>
          <p class="text-xs text-muted-foreground">≈ {p.minutes} minutes of audio</p>
          <ul class="mt-5 flex-1 space-y-2.5 text-sm text-muted-foreground">
            {p.features.map((f) => (
              <li class="flex gap-2"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-success" /> <span>{f}</span></li>
            ))}
          </ul>
          <a href={p.href} class:list={["mt-6 inline-flex h-11 items-center justify-center rounded-xl text-[15px] font-semibold no-underline transition-[filter,background-color]",
            p.popular ? "bg-brand-gradient-strong text-white shadow-brand-glow hover:brightness-110" : "border border-input bg-surface-2 text-foreground hover:bg-surface-3"]}>
            {p.priceMonthly === 0 ? "Start free" : `Choose ${p.name}`}
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-center text-sm text-muted-foreground">Up to 70% less than popular global voice tools, billed in rupees with a GST invoice.</p>
  </div>
</LegalLayout>

<script>
  const root = document.getElementById("plans");
  root?.querySelectorAll<HTMLButtonElement>("[data-period]").forEach((b) =>
    b.addEventListener("click", () => {
      const yearly = b.dataset.period === "yearly";
      root.querySelectorAll("[data-period]").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      root.querySelectorAll(".price-monthly").forEach((e) => e.classList.toggle("hidden", yearly));
      root.querySelectorAll(".price-yearly").forEach((e) => e.classList.toggle("hidden", !yearly));
    }),
  );
</script>
