---
import SeoPage, { type Block } from "../components/SeoPage.astro";
import type { QA } from "../components/Faq.astro";

const blocks: Block[] = [
  {
    h2: "Text to speech that sounds like a person",
    p: [
      "AiWazz turns written text into natural, human-sounding speech. Paste a script, choose one of 14 voices and download a clean audio file you can drop straight into a video, a presentation or a podcast intro.",
      "The voices come from a modern neural text-to-speech model, so they breathe between sentences, stress the right words and avoid the flat, robotic tone of older TTS tools.",
    ],
  },
  {
    h2: "What you get with every file",
    p: ["Most text-to-speech tools stop at “here is some audio”. AiWazz finishes the job so the file is ready to publish:"],
    list: [
      "Loudness levelled to -14 LUFS (or -16, -18, -23) with true peaks under -1 dBTP, the same targets streaming platforms use.",
      "Silence trimmed to about 100 ms at the start and end, with even pauses between sentences and paragraphs.",
      "MP3 at 192 kbps or 16-bit WAV, both at 48 kHz, the sample rate video editors expect.",
      "Speed control from 0.7× to 1.3× for slow explainers or punchy hooks.",
    ],
  },
  {
    h2: "Languages and voices",
    p: [
      "Hindi is a first-class language in AiWazz: four Hindi voices read Devanagari naturally. For English there are six US and four UK voices, from warm and conversational to classic narrator.",
      "Writing in Hinglish? Type it the way you text, in Roman letters, and turn on Transliterate Hinglish: Hindi words are converted to Devanagari for the Hindi voices, English words stay as they are.",
    ],
  },
  {
    h2: "Text to speech for your workflow",
    p: [
      "Use the web dashboard to write, preview and download, or connect your own tools through the AiWazz API with an API key. Video pipelines, content calendars and scripts can all generate voiceovers without anyone clicking a button.",
    ],
  },
];

const faq: QA[] = [
  { q: "Can I use the audio commercially?", a: "Yes, on a paid plan. Paid plans include commercial rights (ads, client work, monetised videos); the Free plan is for personal use. See our Terms at aiwazz.in/terms/." },
  { q: "How much text can I convert at once?", a: "Up to 5,000 characters per voiceover, roughly five to six minutes of speech. Longer scripts can be split into parts." },
  { q: "Which file formats are available?", a: "MP3 (192 kbps) and WAV (16-bit), both at 48 kHz and loudness-normalised." },
  { q: "Does it work on my phone?", a: "Yes. The dashboard is fully responsive, so you can write, preview and download voiceovers from your phone." },
];
---
<SeoPage
  title="Text to speech online: natural AI voices in Hindi & English | AiWazz"
  description="Convert text to natural speech with AiWazz. 14 AI voices in Hindi and English, loudness-normalised MP3 or WAV at 48 kHz, ready in about a minute."
  eyebrow="Text to speech"
  h1="Text to speech with natural AI voices"
  lead="Paste any text, pick a voice in Hindi or English, and download studio-clean audio in about a minute. Type it, hear it."
  blocks={blocks}
  learn={[{ href: "/learn/getting-started/", label: "Getting started with AiWazz" }, { href: "/learn/choosing-a-voice/", label: "How to choose the right voice" }]}
  faq={faq}
  samplesHeading="Listen before you sign up"
  cta="Turn your next script into a voice."
/>
